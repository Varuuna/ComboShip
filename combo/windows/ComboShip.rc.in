// ComboShip.exe icon + version info. CMake fills the @...@ values (combo/CMakeLists.txt).
#include <winver.h>

IDI_ICON1 ICON "@COMBO_RC_ICON@"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     @COMBO_RC_VERSION_COMMAS@
PRODUCTVERSION  @COMBO_RC_VERSION_COMMAS@
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
FILEFLAGS       0
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "@COMBO_PROJECT_TEAM@"
            VALUE "FileDescription",  "ComboShip"
            VALUE "FileVersion",      "@COMBO_RELEASE_VERSION@"
            VALUE "InternalName",     "ComboShip"
            VALUE "OriginalFilename", "ComboShip.exe"
            VALUE "ProductName",      "ComboShip"
            VALUE "ProductVersion",   "@COMBO_RELEASE_VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
